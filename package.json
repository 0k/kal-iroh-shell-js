{
  "name": "@0k/kal-iroh-shell",
  "version": "0.1.0",
  "description": "Page kit of kal-iroh-shell: the page side of the reload handshake, and the Vite plugin that publishes interface releases.",
  "license": "MIT",
  "author": "Valentin Lab <valentin.lab@kalysto.org>",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    }
  },
  "files": [
    "dist",
    "README.org",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "test:vite-matrix": "node scripts/vite-matrix.mjs",
    "typecheck": "tsc --noEmit",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "check": "npm run typecheck && npm run test && npm run build",
    "sync-protocol": "node scripts/sync-protocol.mjs"
  },
  "peerDependencies": {
    "vite": "^5 || ^6 || ^7 || ^8",
    "vue": "^3.3"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "vue": "^3.5.0"
  }
}
